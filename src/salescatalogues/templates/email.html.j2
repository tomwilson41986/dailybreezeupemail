<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ subject }}</title>
</head>
<body style="font-family:-apple-system,Segoe UI,Helvetica,Arial,sans-serif;color:#1a1a1a;background:#f4f4f1;margin:0;padding:24px;">
  <div style="max-width:920px;margin:0 auto;">
    <div style="margin-bottom:20px;">
      <h1 style="margin:0;font-size:22px;font-weight:600;letter-spacing:-0.01em;">Sales catalogues</h1>
      <p style="margin:4px 0 0;color:#666;font-size:13px;">
        {{ run_date.strftime("%A %d %B %Y") }} &middot; {{ total }} catalogue{{ '' if total == 1 else 's' }}
        {%- if active_count %} &middot; {{ active_count }} active{% endif -%}
        {%- if new_count %} &middot; {{ new_count }} new{% endif -%}
      </p>
    </div>

    {#- ───────── Macros ───────── -#}

    {%- macro badge(bg, fg, label) -%}
      <span style="display:inline-block;background:{{ bg }};color:{{ fg }};font-weight:700;font-size:11px;letter-spacing:0.04em;padding:2px 8px;border-radius:10px;">{{ label }}</span>
    {%- endmacro -%}

    {#- Date tile mirrors the rating tile on the breeze-up / barrier-trial cards:
        a rounded swatch with a small label over a big value. Colour tracks
        state — green = active, amber = new, neutral otherwise. -#}
    {%- macro date_tile(cat) -%}
      {%- if cat.is_active -%}
        {%- set bg, fg, label_fg = "#cce5cc", "#1f4a1f", "#3c6c3c" -%}
      {%- elif cat.is_new -%}
        {%- set bg, fg, label_fg = "#f5efde", "#6a5a30", "#8a7a4f" -%}
      {%- else -%}
        {%- set bg, fg, label_fg = "#f0f0ec", "#555", "#888" -%}
      {%- endif -%}
      <table cellpadding="0" cellspacing="0" border="0" style="background:{{ bg }};border-radius:8px;">
        <tr>
          <td style="padding:10px 14px;text-align:center;line-height:1;min-width:54px;">
            {%- if cat.start_date %}
            <div style="font-size:10px;color:{{ label_fg }};font-weight:700;letter-spacing:0.1em;text-transform:uppercase;">{{ cat.start_date.strftime("%b") }}</div>
            <div style="font-size:26px;font-weight:700;color:{{ fg }};margin-top:4px;">{{ cat.start_date.strftime("%-d") }}</div>
            {%- else %}
            <div style="font-size:13px;color:{{ fg }};font-weight:700;letter-spacing:0.08em;padding:6px 0;">TBC</div>
            {%- endif %}
          </td>
        </tr>
      </table>
    {%- endmacro -%}

    {%- macro catalogue_card(cat) -%}
      <table cellpadding="0" cellspacing="0" border="0" width="100%" style="background:#fff;border:1px solid #e3e3de;border-radius:8px;margin-bottom:12px;">
        <tr>
          <td style="padding:14px 16px;vertical-align:middle;">
            <div style="font-size:10px;color:#888;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;">
              <span title="{{ cat.country_name }}" style="font-size:14px;vertical-align:-1px;letter-spacing:0;">{{ cat.country_flag }}</span>&nbsp;
              {%- if cat.house_url %}<a href="{{ cat.house_url }}" style="color:#888;text-decoration:none;">{{ cat.house }}</a>{% else %}{{ cat.house }}{% endif -%}
              <span style="color:#bbb;">&nbsp;&middot;&nbsp;{{ cat.country_name }}</span>
            </div>
            <div style="font-size:17px;font-weight:600;color:#1a1a1a;margin-top:3px;">
              <a href="{{ cat.url }}" style="color:#1a5fb4;text-decoration:none;">{{ cat.name }}</a>
            </div>
            <div style="font-size:13px;color:#555;margin-top:4px;">
              {{ cat.type_icon }} {{ cat.sale_type }}
              <span style="color:#ccc;margin:0 6px;">&middot;</span>
              {{ cat.date_label() }}
            </div>
            <div style="margin-top:9px;line-height:1.9;">
              {%- if cat.is_active %}{{ badge("#cce5cc", "#1f4a1f", "ACTIVE") }} {% endif -%}
              {%- if cat.is_new %}{{ badge("#f5efde", "#6a5a30", "NEW") }} {% endif -%}
              {%- if cat.online %}{{ badge("#e2e6ea", "#3d4750", "ONLINE") }} {% endif -%}
              {%- if not cat.is_active and not cat.is_new and cat.status_label and cat.status_label != "Upcoming" %}{{ badge("#ececec", "#555", cat.status_label) }}{% endif -%}
            </div>
            <div style="margin-top:9px;font-size:12px;">
              <a href="{{ cat.url }}" style="color:#1a5fb4;text-decoration:none;font-weight:600;">View sale &amp; catalogue &rsaquo;</a>
              {%- if cat.house_url %}
              <span style="color:#ccc;margin:0 8px;">&middot;</span>
              <a href="{{ cat.house_url }}" style="color:#1a5fb4;text-decoration:none;font-weight:600;">{{ cat.house }} website &rsaquo;</a>
              {%- endif %}
            </div>
          </td>
          <td style="padding:14px 16px;vertical-align:middle;text-align:right;width:1%;white-space:nowrap;">
            {{ date_tile(cat) }}
          </td>
        </tr>
      </table>
    {%- endmacro -%}

    {#- ───────── Chronological list (nearest sale first) ───────── -#}

    {% if catalogues %}
      <h2 style="font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#666;margin:24px 0 10px;">
        By sale date &middot; nearest first
      </h2>
      {% for cat in catalogues %}{{ catalogue_card(cat) }}{% endfor %}
    {% else %}
      <div style="background:#fff;border:1px solid #e3e3de;border-radius:8px;padding:20px;">
        <p style="margin:0;color:#444;font-size:15px;font-weight:600;">No New or Active catalogues today</p>
        <p style="margin:6px 0 0;color:#888;font-size:13px;">No thoroughbred sale catalogues are new or within their active window. The full forward calendar is attached as CSV.</p>
      </div>
    {% endif %}

    <p style="margin-top:24px;color:#aaa;font-size:11px;line-height:1.5;">
      Full lot-by-lot list attached as <strong style="color:#888;">sales_catalogues_{{ run_date.isoformat() }}.csv</strong> (one row per catalogued lot, where the catalogue is published).
      New = first day a catalogue is listed; Active = from 2 days before the sale through its final day.
      Jumps / National Hunt / store sales excluded.
      <br>Sources: Tattersalls, Tattersalls Ireland, Goffs, Arqana, BBAG, Keeneland, Fasig-Tipton, OBS, Inglis, Magic Millions, NZB, Gavelhouse.
      {%- if diagnostics and diagnostics.get("source_status") %}
      <br><span style="color:#c4c4c4;">Source status: {{ diagnostics.source_status }}.</span>
      {%- endif %}
    </p>
  </div>
</body>
</html>
