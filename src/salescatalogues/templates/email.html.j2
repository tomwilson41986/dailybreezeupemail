{#- Daily Sales Catalogues digest. Email-safe inline styles only. -#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#f4f5f7;font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;color:#1a1a1a;">
<div style="max-width:680px;margin:0 auto;padding:20px 14px;">

  <div style="background:#0b2545;border-radius:10px;padding:20px 22px;color:#ffffff;">
    <div style="font-size:13px;letter-spacing:1px;text-transform:uppercase;opacity:.8;">Daily Sales Catalogues</div>
    <div style="font-size:22px;font-weight:700;margin-top:4px;">Thoroughbred Sales Worldwide</div>
    <div style="font-size:14px;margin-top:6px;opacity:.85;">{{ run_date.strftime('%A %-d %B %Y') }}</div>
    <div style="margin-top:14px;font-size:13px;">
      <span style="display:inline-block;background:#e63946;color:#fff;border-radius:14px;padding:3px 11px;margin-right:6px;font-weight:600;">&#9679; {{ active_count }} Active</span>
      <span style="display:inline-block;background:#2a9d8f;color:#fff;border-radius:14px;padding:3px 11px;margin-right:6px;font-weight:600;">&#10024; {{ new_count }} New</span>
      <span style="display:inline-block;background:#ffffff22;color:#fff;border-radius:14px;padding:3px 11px;font-weight:600;">{{ total }} catalogues</span>
    </div>
  </div>

  {% if sections %}
    {% for country, rows in sections %}
    <div style="margin-top:24px;">
      <div style="font-size:18px;font-weight:700;border-bottom:2px solid #0b2545;padding-bottom:6px;">
        <span style="font-size:22px;">{{ country.flag }}</span>&nbsp;{{ country.name }}
        <span style="font-size:13px;font-weight:500;color:#6b7280;">&nbsp;&middot;&nbsp;{{ rows|length }}</span>
      </div>

      {% for r in rows %}
      <div style="background:#ffffff;border:1px solid #e5e7eb;{% if r.is_active %}border-left:4px solid #e63946;{% elif r.is_new %}border-left:4px solid #2a9d8f;{% else %}border-left:4px solid #cbd5e1;{% endif %}border-radius:8px;padding:12px 14px;margin-top:10px;">
        <div style="font-size:12px;color:#6b7280;font-weight:600;text-transform:uppercase;letter-spacing:.4px;">{{ r.house }}</div>
        <div style="font-size:16px;font-weight:700;margin-top:2px;">
          <a href="{{ r.url }}" style="color:#0b2545;text-decoration:none;">{{ r.name }}</a>
        </div>
        <div style="font-size:13px;color:#374151;margin-top:5px;">
          <span style="margin-right:10px;">{{ r.type_icon }} {{ r.sale_type }}</span>
          <span style="margin-right:10px;">&#128197; {{ r.date_label() }}</span>
        </div>
        <div style="margin-top:8px;">
          {% if r.is_active %}<span style="display:inline-block;background:#e63946;color:#fff;border-radius:4px;padding:2px 8px;font-size:11px;font-weight:700;margin-right:5px;">&#9679; ACTIVE</span>{% endif %}
          {% if r.is_new %}<span style="display:inline-block;background:#2a9d8f;color:#fff;border-radius:4px;padding:2px 8px;font-size:11px;font-weight:700;margin-right:5px;">&#10024; NEW</span>{% endif %}
          {% if r.online %}<span style="display:inline-block;background:#3a86ff;color:#fff;border-radius:4px;padding:2px 8px;font-size:11px;font-weight:700;margin-right:5px;">&#128187; ONLINE</span>{% endif %}
          {% if not r.is_active and not r.is_new and r.status_label %}<span style="display:inline-block;background:#eef2f7;color:#475569;border-radius:4px;padding:2px 8px;font-size:11px;font-weight:600;">{{ r.status_label }}</span>{% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
    {% endfor %}
  {% else %}
    <div style="margin-top:24px;background:#ffffff;border:1px solid #e5e7eb;border-radius:8px;padding:20px;text-align:center;color:#6b7280;">
      No New or Active thoroughbred sales catalogues today.
    </div>
  {% endif %}

  <div style="margin-top:26px;font-size:12px;color:#9ca3af;line-height:1.6;">
    <div>Full list attached as <strong>sales_catalogues_{{ run_date.isoformat() }}.csv</strong>.</div>
    <div style="margin-top:4px;">Sources: Tattersalls, Tattersalls Ireland, Goffs, Arqana, BBAG, Keeneland, Fasig-Tipton, OBS, Inglis, Magic Millions, NZB, Gavelhouse. Jumps / National Hunt / store sales excluded.</div>
    {% if diagnostics and diagnostics.get('source_status') %}
    <div style="margin-top:6px;">Source status: {{ diagnostics.source_status }}</div>
    {% endif %}
  </div>

</div>
</body>
</html>
