<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ subject }}</title>
</head>
<body style="font-family:-apple-system,Segoe UI,Helvetica,Arial,sans-serif;color:#1a1a1a;background:#f4f4f1;margin:0;padding:24px;">
  <div style="max-width:920px;margin:0 auto;">
    <div style="margin-bottom:20px;">
      <h1 style="margin:0;font-size:22px;font-weight:600;letter-spacing:-0.01em;">Barrier-trial watchlist</h1>
      <p style="margin:4px 0 0;color:#666;font-size:13px;">
        {{ run_date.strftime("%A %d %B %Y") }} &middot; {{ total }} horse{{ '' if total == 1 else 's' }}
      </p>
    </div>

    {#- ───────── Macros ───────── -#}

    {%- macro rating_tile(label, value) -%}
      {%- if value is none -%}
        {%- set bg = "#f0f0ec" -%}{%- set fg = "#666" -%}{%- set label_fg = "#888" -%}
      {%- elif value >= 90 -%}
        {%- set bg = "#cce5cc" -%}{%- set fg = "#1f4a1f" -%}{%- set label_fg = "#3c6c3c" -%}
      {%- elif value >= 70 -%}
        {%- set bg = "#e3f0e3" -%}{%- set fg = "#2d5b2d" -%}{%- set label_fg = "#557a55" -%}
      {%- elif value >= 50 -%}
        {%- set bg = "#f5efde" -%}{%- set fg = "#6a5a30" -%}{%- set label_fg = "#8a7a4f" -%}
      {%- else -%}
        {%- set bg = "#ececec" -%}{%- set fg = "#555" -%}{%- set label_fg = "#888" -%}
      {%- endif -%}
      <table cellpadding="0" cellspacing="0" border="0" style="background:{{ bg }};border-radius:8px;">
        <tr>
          <td style="padding:14px 18px;text-align:center;line-height:1;min-width:96px;">
            <div style="font-size:10px;color:{{ label_fg }};font-weight:700;letter-spacing:0.1em;text-transform:uppercase;">{{ label }}</div>
            <div style="font-size:28px;font-weight:700;color:{{ fg }};margin-top:6px;">
              {%- if value is not none -%}{{ "%.1f"|format(value) }}{%- else -%}&mdash;{%- endif -%}
            </div>
          </td>
        </tr>
      </table>
    {%- endmacro -%}

    {%- macro pos_badge(pos, total=none) -%}
      {%- if pos == "1" -%}
        {%- set bg, fg = "#fce99c", "#7a5a00" -%}
      {%- elif pos == "2" -%}
        {%- set bg, fg = "#e2e6ea", "#3d4750" -%}
      {%- elif pos == "3" -%}
        {%- set bg, fg = "#f0d9bf", "#7a4a1a" -%}
      {%- else -%}
        {%- set bg, fg = "#ececec", "#444" -%}
      {%- endif -%}
      <span style="display:inline-block;background:{{ bg }};color:{{ fg }};font-weight:700;font-size:13px;padding:2px 10px;border-radius:10px;">{{ pos or "—" }}{% if total %}<span style="color:#888;font-weight:600;"> / {{ total }}</span>{% endif %}</span>
    {%- endmacro -%}

    {%- macro status_badge(kind, label) -%}
      {%- if kind == "won" -%}
        {%- set bg, fg = "#cce5cc", "#1f4a1f" -%}
      {%- elif kind == "placed" -%}
        {%- set bg, fg = "#f5efde", "#6a5a30" -%}
      {%- elif kind == "ran" -%}
        {%- set bg, fg = "#ececec", "#555" -%}
      {%- else -%}
        {%- set bg, fg = "#f4f4f1", "#999" -%}
      {%- endif -%}
      <span style="display:inline-block;background:{{ bg }};color:{{ fg }};font-weight:700;font-size:11px;letter-spacing:0.04em;padding:2px 8px;border-radius:10px;">{{ label }}</span>
    {%- endmacro -%}

    {%- macro stat_row(label, n_runners, n_winners, strike_rate, avg_rpr, low_n) -%}
      {%- if low_n -%}
        {%- set rowstyle = "color:#999;font-style:italic;" -%}
      {%- else -%}
        {%- set rowstyle = "color:#1a1a1a;" -%}
      {%- endif -%}
      <tr style="{{ rowstyle }}">
        <td style="padding:6px 8px;font-size:13px;border-top:1px solid #efefe9;">{{ label }}</td>
        <td style="padding:6px 8px;font-size:13px;text-align:right;border-top:1px solid #efefe9;">{{ n_runners }}</td>
        <td style="padding:6px 8px;font-size:13px;text-align:right;border-top:1px solid #efefe9;">{{ n_winners }}</td>
        <td style="padding:6px 8px;font-size:13px;text-align:right;border-top:1px solid #efefe9;font-weight:600;">{{ "%.0f%%"|format(strike_rate * 100) }}</td>
        <td style="padding:6px 8px;font-size:13px;text-align:right;border-top:1px solid #efefe9;">{% if avg_rpr is not none %}{{ "%.0f"|format(avg_rpr) }}{% else %}&mdash;{% endif %}</td>
      </tr>
    {%- endmacro -%}

    {%- macro stat_table_header() -%}
      <thead>
        <tr>
          <th style="padding:6px 8px;text-align:left;font-size:10px;color:#888;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;">Band</th>
          <th style="padding:6px 8px;text-align:right;font-size:10px;color:#888;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;">Runners</th>
          <th style="padding:6px 8px;text-align:right;font-size:10px;color:#888;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;">Wins</th>
          <th style="padding:6px 8px;text-align:right;font-size:10px;color:#888;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;">SR</th>
          <th style="padding:6px 8px;text-align:right;font-size:10px;color:#888;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;">Avg RPR</th>
        </tr>
      </thead>
    {%- endmacro -%}

    {%- macro runs_table(runs) -%}
      <table cellpadding="0" cellspacing="0" border="0" width="100%" style="margin-top:4px;">
        <thead>
          <tr>
            <th style="padding:4px 8px;text-align:left;font-size:9px;color:#999;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;">Date</th>
            <th style="padding:4px 8px;text-align:left;font-size:9px;color:#999;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;">Course / Race</th>
            <th style="padding:4px 8px;text-align:left;font-size:9px;color:#999;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;">Pos</th>
            <th style="padding:4px 8px;text-align:right;font-size:9px;color:#999;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;">SP</th>
            <th style="padding:4px 8px;text-align:right;font-size:9px;color:#999;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;">RPR</th>
          </tr>
        </thead>
        <tbody>
          {%- for run in runs %}
          <tr>
            <td style="padding:5px 8px;font-size:12px;color:#444;border-top:1px solid #efefe9;white-space:nowrap;">{{ run.race_date.strftime("%d %b") if run.race_date else "—" }}</td>
            <td style="padding:5px 8px;font-size:12px;color:#1a1a1a;border-top:1px solid #efefe9;">{{ run.course }}{% if run.race_name %} <span style="color:#999;">&middot; {{ run.race_name }}</span>{% endif %}</td>
            <td style="padding:5px 8px;font-size:12px;border-top:1px solid #efefe9;">{{ pos_badge(run.finishing_position, run.total_runners) }}</td>
            <td style="padding:5px 8px;font-size:12px;color:#444;text-align:right;border-top:1px solid #efefe9;">{{ run.sp or "—" }}</td>
            <td style="padding:5px 8px;font-size:12px;text-align:right;border-top:1px solid #efefe9;font-weight:600;">{% if run.rpr is not none %}{{ run.rpr }}{% else %}&mdash;{% endif %}</td>
          </tr>
          {%- endfor %}
        </tbody>
      </table>
    {%- endmacro -%}

    {%- macro record_card(rec) -%}
      <table cellpadding="0" cellspacing="0" border="0" width="100%" style="background:#fff;border:1px solid #e3e3de;border-radius:8px;margin-bottom:12px;">
        <tr>
          <td style="padding:12px 16px 4px;vertical-align:middle;">
            <div style="font-size:15px;font-weight:600;color:#1a1a1a;">{{ rec.horse_name }}</div>
            <div style="font-size:12px;color:#666;margin-top:2px;">
              {{ status_badge(rec.status_kind, rec.status_label) }}
              <span style="margin-left:6px;">{{ rec.n_runs }} run{{ '' if rec.n_runs == 1 else 's' }}{% if rec.n_wins %} &middot; {{ rec.n_wins }}W{% endif %}{% if rec.n_places %} &middot; {{ rec.n_places }}P{% endif %}{% if rec.peak_rpr is not none %} &middot; peak RPR {{ rec.peak_rpr }}{% endif %}</span>
            </div>
          </td>
          <td style="padding:12px 16px 4px;vertical-align:top;text-align:right;width:1%;white-space:nowrap;">
            {%- if rec.ratings %}
            <table cellpadding="0" cellspacing="0" border="0"><tr>
              {%- for label, value in rec.ratings.items() %}
              <td style="{% if not loop.last %}padding-right:8px;{% endif %}">{{ rating_tile(label, value) }}</td>
              {%- endfor %}
            </tr></table>
            {%- endif %}
          </td>
        </tr>
        <tr><td colspan="2" style="padding:0 12px 12px;">{{ runs_table(rec.runs) }}</td></tr>
      </table>
    {%- endmacro -%}

    {%- macro horse_card(row, ran=false) -%}
      {%- set ncols = 3 if row.silk_cid else 2 -%}
      <table cellpadding="0" cellspacing="0" border="0" width="100%" style="background:#fff;border:1px solid #e3e3de;border-radius:8px;margin-bottom:12px;">
        {#- ─ row 1: silk + name + rating tiles ─ -#}
        <tr>
          {%- if row.silk_cid %}
          <td style="padding:14px 0 8px 16px;vertical-align:middle;width:64px;">
            <img src="cid:{{ row.silk_cid }}" alt="silks" width="56" height="40"
                 style="background:#fff;display:block;border-radius:4px;">
          </td>
          {%- endif %}
          <td style="padding:14px 16px 8px{% if row.silk_cid %} 12px{% endif %};vertical-align:middle;">
            <div style="font-size:17px;font-weight:600;color:#1a1a1a;">
              {{ row.horse_name or "(unnamed)" }}
            </div>
          </td>
          <td style="padding:14px 16px 8px;vertical-align:top;text-align:right;width:1%;white-space:nowrap;">
            {%- if row.ratings %}
            <table cellpadding="0" cellspacing="0" border="0"><tr>
              {%- for label, value in row.ratings.items() %}
              <td style="{% if not loop.last %}padding-right:8px;{% endif %}">{{ rating_tile(label, value) }}</td>
              {%- endfor %}
            </tr></table>
            {%- endif %}
          </td>
        </tr>
        {#- ─ row 2: race line ─ -#}
        <tr>
          <td colspan="{{ ncols }}" style="padding:6px 16px 8px;">
            <div style="font-size:14px;color:#1a1a1a;">
              {%- if ran %}
                {{ pos_badge(row.finishing_position, row.total_runners) }}
                <span style="margin-left:6px;color:#444;">SP {{ row.sp or "—" }}</span>
                <span style="color:#bbb;margin:0 8px;">|</span>
                {%- if row.off_time %}<strong>{{ row.off_time.strftime("%H:%M") }}</strong> {% endif -%}
                <a href="{{ row.race_url }}" style="color:#1a5fb4;text-decoration:none;font-weight:600;">{{ row.course }}</a>
                {%- if row.race_name %} &middot; <span style="color:#666;">{{ row.race_name }}</span>{% endif %}
              {%- else %}
                <strong>{{ row.race_date.strftime("%a %d %b") }}</strong>
                {%- if row.off_time %} <strong>{{ row.off_time.strftime("%H:%M") }}</strong>{% endif %}
                <span style="color:#bbb;margin:0 8px;">|</span>
                <a href="{{ row.race_url }}" style="color:#1a5fb4;text-decoration:none;font-weight:600;">{{ row.course }}</a>
                {%- if row.race_name %} &middot; <span style="color:#666;">{{ row.race_name }}</span>{% endif %}
              {%- endif %}
            </div>
          </td>
        </tr>
        {#- ─ row 3: full watchlist row — every sheet column ─ -#}
        {%- if row.fields %}
        <tr>
          <td colspan="{{ ncols }}" style="padding:2px 12px 14px;">
            <table cellpadding="0" cellspacing="0" border="0" width="100%" style="border-top:1px solid #efefe9;margin-top:4px;">
              <tr>
                {%- for label, value in row.fields.items() %}
                <td style="padding:6px 4px;vertical-align:top;width:{{ (100 / (row.fields|length if row.fields|length < 6 else 6))|round(0,'floor')|int }}%;">
                  <div style="font-size:9px;color:#999;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;white-space:nowrap;">{{ label }}</div>
                  <div style="font-size:12px;color:#1a1a1a;margin-top:1px;">{{ value if value else "—" }}</div>
                </td>
                {%- if loop.index % 6 == 0 and not loop.last %}</tr><tr>{% endif %}
                {%- endfor %}
              </tr>
            </table>
          </td>
        </tr>
        {%- endif %}
        {#- ─ row 4: results so far this season (entries email only) ─ -#}
        {%- if not ran and row.history %}
        <tr>
          <td colspan="{{ ncols }}" style="padding:0 16px 14px;">
            <div style="font-size:10px;color:#888;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;border-top:1px solid #efefe9;padding-top:8px;">
              Results so far &middot; {{ row.history|length }}
            </div>
            {{ runs_table(row.history) }}
          </td>
        </tr>
        {%- endif %}
      </table>
    {%- endmacro -%}

    {#- ───────── Sections ───────── -#}

    {% if mode == "evening" %}
      {% if ran_today %}
      <h2 style="font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#666;margin:24px 0 10px;">
        Ran today &middot; {{ ran_today|length }}
      </h2>
      {% for row in ran_today %}{{ horse_card(row, ran=true) }}{% endfor %}
      {% else %}
      <div style="background:#fff;border:1px solid #e3e3de;border-radius:8px;padding:20px;">
        <p style="margin:0;color:#444;font-size:15px;font-weight:600;">No Results Today</p>
      </div>
      {% endif %}

      {% if season_summary %}
      <h2 style="font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#666;margin:32px 0 10px;">
        Historic results &middot; since {{ season_summary.season_start }} &middot; {{ season_summary.total_runs }} run{{ '' if season_summary.total_runs == 1 else 's' }}
      </h2>

      {#- Performance per rating band -#}
      {% for rating in season_summary.by_rating %}
      {% if rating.bands %}
      <table cellpadding="0" cellspacing="0" border="0" width="100%" style="background:#fff;border:1px solid #e3e3de;border-radius:8px;margin-bottom:12px;">
        <tr><td colspan="5" style="padding:10px 12px 4px;font-size:12px;font-weight:700;color:#1a1a1a;letter-spacing:0.04em;">Performance by {{ rating.label }} band</td></tr>
        {{ stat_table_header() }}
        <tbody>
          {%- for r in rating.bands %}
          {{ stat_row(r.label, r.n_runners, r.n_winners, r.strike_rate, r.avg_rpr, r.low_n) }}
          {%- endfor %}
        </tbody>
      </table>
      {% endif %}
      {% endfor %}
      <p style="font-size:11px;color:#999;font-style:italic;margin:0 0 8px;">
        Italic rows = small sample (n &lt; {{ season_summary.low_n_threshold }}).
      </p>

      {#- Per-horse tracker: every tracked horse that has run, with its results -#}
      {% if season_summary.horses %}
      <h3 style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#666;margin:20px 0 8px;">
        Tracked horses &amp; results &middot; {{ season_summary.horses|length }}
      </h3>
      {% for rec in season_summary.horses %}{{ record_card(rec) }}{% endfor %}
      {% endif %}
      {% endif %}
    {% else %}
      {% if entered %}
      <h2 style="font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#666;margin:24px 0 10px;">
        Entries &amp; declarations &middot; next {{ entries_window_days }} day{{ '' if entries_window_days == 1 else 's' }} &middot; {{ entered|length }}
      </h2>
      {% for row in entered %}{{ horse_card(row) }}{% endfor %}
      {% else %}
      <div style="background:#fff;border:1px solid #e3e3de;border-radius:8px;padding:20px;">
        <p style="margin:0;color:#444;">No watchlist horses entered in the next {{ entries_window_days }} day{{ '' if entries_window_days == 1 else 's' }}.</p>
      </div>
      {% endif %}
    {% endif %}

    {% if diagnostics and diagnostics.get("sheet_status") and total > 0 %}
    <p style="margin-top:18px;color:#999;font-size:11px;">
      Watchlist: {{ diagnostics.sheet_status }}.
    </p>
    {% endif %}

    <p style="margin-top:24px;color:#aaa;font-size:11px;line-height:1.5;">
      Sourced from Racing Post racecards (entries/declarations) and results, matched to the
      watchlist by horse name and the learned Racing Post horse id.
    </p>
  </div>
</body>
</html>
