<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ subject }}</title>
</head>
<body style="font-family:-apple-system,Segoe UI,Helvetica,Arial,sans-serif;color:#1a1a1a;background:#f4f4f1;margin:0;padding:24px;">
  <div style="max-width:920px;margin:0 auto;">
    <div style="margin-bottom:20px;">
      <h1 style="margin:0;font-size:22px;font-weight:600;letter-spacing:-0.01em;">Breeze-up graduates</h1>
      <p style="margin:4px 0 0;color:#666;font-size:13px;">
        {{ run_date.strftime("%A %d %B %Y") }} &middot; {{ total }} horse{{ '' if total == 1 else 's' }}
      </p>
    </div>

    {#- ───────── Macros ───────── -#}

    {%- macro rating_tile(label, value) -%}
      {%- if value is none -%}
        {%- set bg = "#f0f0ec" -%}{%- set fg = "#666" -%}{%- set label_fg = "#888" -%}
      {%- elif value >= 90 -%}
        {%- set bg = "#cce5cc" -%}{%- set fg = "#1f4a1f" -%}{%- set label_fg = "#3c6c3c" -%}
      {%- elif value >= 70 -%}
        {%- set bg = "#e3f0e3" -%}{%- set fg = "#2d5b2d" -%}{%- set label_fg = "#557a55" -%}
      {%- elif value >= 50 -%}
        {%- set bg = "#f5efde" -%}{%- set fg = "#6a5a30" -%}{%- set label_fg = "#8a7a4f" -%}
      {%- else -%}
        {%- set bg = "#ececec" -%}{%- set fg = "#555" -%}{%- set label_fg = "#888" -%}
      {%- endif -%}
      <table cellpadding="0" cellspacing="0" border="0" style="background:{{ bg }};border-radius:8px;">
        <tr>
          <td style="padding:14px 18px;text-align:center;line-height:1;min-width:96px;">
            <div style="font-size:10px;color:{{ label_fg }};font-weight:700;letter-spacing:0.1em;">{{ label }}</div>
            <div style="font-size:28px;font-weight:700;color:{{ fg }};margin-top:6px;">
              {%- if value is not none -%}{{ "%.1f"|format(value) }}{%- else -%}&mdash;{%- endif -%}
            </div>
          </td>
        </tr>
      </table>
    {%- endmacro -%}

    {%- macro pos_badge(pos, total=none) -%}
      {%- if pos == "1" -%}
        {%- set bg, fg = "#fce99c", "#7a5a00" -%}
      {%- elif pos == "2" -%}
        {%- set bg, fg = "#e2e6ea", "#3d4750" -%}
      {%- elif pos == "3" -%}
        {%- set bg, fg = "#f0d9bf", "#7a4a1a" -%}
      {%- else -%}
        {%- set bg, fg = "#ececec", "#444" -%}
      {%- endif -%}
      <span style="display:inline-block;background:{{ bg }};color:{{ fg }};font-weight:700;font-size:13px;padding:2px 10px;border-radius:10px;">{{ pos or "—" }}{% if total %}<span style="color:#888;font-weight:600;"> / {{ total }}</span>{% endif %}</span>
    {%- endmacro -%}

    {%- macro status_badge(kind, label) -%}
      {%- if kind == "won" -%}
        {%- set bg, fg = "#cce5cc", "#1f4a1f" -%}
      {%- elif kind == "placed" -%}
        {%- set bg, fg = "#f5efde", "#6a5a30" -%}
      {%- elif kind == "ran" -%}
        {%- set bg, fg = "#ececec", "#555" -%}
      {%- else -%}
        {%- set bg, fg = "#f4f4f1", "#999" -%}
      {%- endif -%}
      <span style="display:inline-block;background:{{ bg }};color:{{ fg }};font-weight:700;font-size:11px;letter-spacing:0.04em;padding:2px 8px;border-radius:10px;">{{ label }}</span>
    {%- endmacro -%}

    {%- macro stat_row(label, n_runners, n_winners, strike_rate, avg_rpr, low_n) -%}
      {%- if low_n -%}
        {%- set rowstyle = "color:#999;font-style:italic;" -%}
      {%- else -%}
        {%- set rowstyle = "color:#1a1a1a;" -%}
      {%- endif -%}
      <tr style="{{ rowstyle }}">
        <td style="padding:6px 8px;font-size:13px;border-top:1px solid #efefe9;">{{ label }}</td>
        <td style="padding:6px 8px;font-size:13px;text-align:right;border-top:1px solid #efefe9;">{{ n_runners }}</td>
        <td style="padding:6px 8px;font-size:13px;text-align:right;border-top:1px solid #efefe9;">{{ n_winners }}</td>
        <td style="padding:6px 8px;font-size:13px;text-align:right;border-top:1px solid #efefe9;font-weight:600;">{{ "%.0f%%"|format(strike_rate * 100) }}</td>
        <td style="padding:6px 8px;font-size:13px;text-align:right;border-top:1px solid #efefe9;">{% if avg_rpr is not none %}{{ "%.0f"|format(avg_rpr) }}{% else %}&mdash;{% endif %}</td>
      </tr>
    {%- endmacro -%}

    {%- macro stat_table_header() -%}
      <thead>
        <tr>
          <th style="padding:6px 8px;text-align:left;font-size:10px;color:#888;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;">Band</th>
          <th style="padding:6px 8px;text-align:right;font-size:10px;color:#888;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;">Runners</th>
          <th style="padding:6px 8px;text-align:right;font-size:10px;color:#888;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;">Wins</th>
          <th style="padding:6px 8px;text-align:right;font-size:10px;color:#888;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;">SR</th>
          <th style="padding:6px 8px;text-align:right;font-size:10px;color:#888;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;">Avg RPR</th>
        </tr>
      </thead>
    {%- endmacro -%}

    {%- macro top_table(rows, rating_label) -%}
      <table cellpadding="0" cellspacing="0" border="0" width="100%" style="background:#fff;border:1px solid #e3e3de;border-radius:8px;margin-bottom:12px;">
        <thead>
          <tr>
            <th style="padding:8px;text-align:right;font-size:10px;color:#888;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;width:1%;">#</th>
            <th style="padding:8px;text-align:right;font-size:10px;color:#888;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;">{{ rating_label }}</th>
            <th style="padding:8px;text-align:left;font-size:10px;color:#888;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;">Horse</th>
            <th style="padding:8px;text-align:left;font-size:10px;color:#888;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;">Status</th>
            <th style="padding:8px;text-align:right;font-size:10px;color:#888;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;">Peak RPR</th>
          </tr>
        </thead>
        <tbody>
          {%- for h in rows %}
          <tr>
            <td style="padding:8px;font-size:13px;text-align:right;color:#888;border-top:1px solid #efefe9;">{{ loop.index }}</td>
            <td style="padding:8px;font-size:14px;font-weight:700;text-align:right;border-top:1px solid #efefe9;">{% if h.rating is not none %}{{ "%.1f"|format(h.rating) }}{% else %}&mdash;{% endif %}</td>
            <td style="padding:8px;font-size:13px;border-top:1px solid #efefe9;">
              <div style="color:#1a1a1a;font-weight:600;">{{ h.horse_name }}</div>
              <div style="color:#888;font-size:11px;">{{ h.lot_label }}{% if h.lot_label and h.sale_label %} &middot; {% endif %}{{ h.sale_label }}</div>
            </td>
            <td style="padding:8px;font-size:13px;border-top:1px solid #efefe9;">{{ status_badge(h.status_kind, h.status_label) }}</td>
            <td style="padding:8px;font-size:13px;text-align:right;border-top:1px solid #efefe9;font-weight:600;">{% if h.peak_rpr is not none %}{{ h.peak_rpr }}{% else %}&mdash;{% endif %}</td>
          </tr>
          {%- endfor %}
        </tbody>
      </table>
    {%- endmacro -%}

    {%- macro horse_card(row, ran=false, show_date=false) -%}
      {%- set sire = row.sheet_sire or row.sire -%}
      {%- set dam = row.sheet_dam or row.dam -%}
      {%- set price = row.sheet_price or row.price -%}
      {%- set buyer = row.sheet_buyer or row.buyer -%}
      {%- set vendor = row.sheet_vendor or row.seller -%}
      {%- set short_sale = (row.sale_short ~ " " ~ row.sale_year) if row.sale_short else row.sale_name -%}
      {%- set ncols = 3 if row.silk_cid else 2 -%}
      <table cellpadding="0" cellspacing="0" border="0" width="100%" style="background:#fff;border:1px solid #e3e3de;border-radius:8px;margin-bottom:12px;">
        {#- ─ row 1: silk + identity + rating tile ─ -#}
        <tr>
          {%- if row.silk_cid %}
          <td style="padding:14px 0 8px 16px;vertical-align:middle;width:64px;">
            <img src="cid:{{ row.silk_cid }}" alt="silks" width="56" height="40"
                 style="background:#fff;display:block;border-radius:4px;">
          </td>
          {%- endif %}
          <td style="padding:14px 16px 8px{% if row.silk_cid %} 12px{% endif %};vertical-align:top;">
            <div style="font-size:17px;font-weight:600;color:#1a1a1a;">
              {{ row.horse_name or ("Lot " ~ row.lot ~ " (unnamed)") }}
            </div>
            {%- if sire or dam %}
            <div style="font-size:13px;color:#555;margin-top:2px;">
              {{ sire or "?" }} &times; {{ dam or "?" }}{% if row.damsire %} <span style="color:#888;">(by {{ row.damsire }})</span>{% endif %}
            </div>
            {%- endif %}
          </td>
          <td style="padding:14px 16px 8px;vertical-align:top;text-align:right;width:1%;white-space:nowrap;">
            {%- if row.sheet_matched %}
            <table cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td style="padding-right:8px;">{{ rating_tile("BREEZE", row.sheet_breeze_rating) }}</td>
                <td>{{ rating_tile("PRECOCITY", row.sheet_precocity_rating) }}</td>
              </tr>
            </table>
            {%- endif %}
          </td>
        </tr>
        {#- ─ row 2: race line ─ -#}
        <tr>
          <td colspan="{{ ncols }}" style="padding:6px 16px 0;">
            <div style="font-size:14px;color:#1a1a1a;">
              {%- if ran %}
                {{ pos_badge(row.finishing_position, row.total_runners) }}
                <span style="margin-left:6px;color:#444;">SP {{ row.sp or "—" }}</span>
                <span style="color:#bbb;margin:0 8px;">|</span>
                {%- if show_date and row.race_date %}<strong>{{ row.race_date.strftime("%a %d %b") }}</strong> {% endif -%}
                {%- if row.off_time %}<strong>{{ row.off_time.strftime("%H:%M") }}</strong> {% endif -%}
                {%- if row.race_url %}<a href="{{ row.race_url }}" style="color:#1a5fb4;text-decoration:none;font-weight:600;">{{ row.course }}</a>
                {%- else %}<span style="font-weight:600;">{{ row.course }}</span>{% endif -%}
                {%- if row.race_name %} &middot; <span style="color:#666;">{{ row.race_name }}</span>{% endif %}
                {%- if row.rpr is defined and row.rpr is not none %} &middot; <span style="color:#444;font-weight:600;">RPR {{ row.rpr }}</span>{% endif %}
              {%- else %}
                <strong>{{ row.race_date.strftime("%a %d %b") }}</strong>
                {%- if row.off_time %} <strong>{{ row.off_time.strftime("%H:%M") }}</strong>{% endif %}
                <span style="color:#bbb;margin:0 8px;">|</span>
                {%- if row.race_url %}<a href="{{ row.race_url }}" style="color:#1a5fb4;text-decoration:none;font-weight:600;">{{ row.course }}</a>
                {%- else %}<span style="font-weight:600;">{{ row.course }}</span>{% endif -%}
                {%- if row.race_name %} &middot; <span style="color:#666;">{{ row.race_name }}</span>{% endif %}
              {%- endif %}
            </div>
          </td>
        </tr>
        {#- ─ row 3: stats line ─ -#}
        {%- if row.sheet_matched and (row.sheet_ot_rank is not none or row.sheet_sl_1f is not none or row.sheet_sl_go is not none) %}
        <tr>
          <td colspan="{{ ncols }}" style="padding:8px 16px 0;">
            <div style="font-size:12px;color:#666;line-height:1.6;">
              {%- if row.sheet_ot_rank is not none -%}
                <span style="color:#444;font-weight:600;">OT</span>
                #{{ row.sheet_ot_rank }}{% if row.sheet_sale_total %}<span style="color:#999;">/{{ row.sheet_sale_total }}</span>{% endif %}
                {%- if row.sheet_ot_diff_m is not none %} <span style="color:#888;">({{ "%+.2fs"|format(row.sheet_ot_diff_m) }})</span>{% endif %}
              {%- endif -%}
              {%- if row.sheet_sl_1f is not none or row.sheet_sl_go is not none %}
                <span style="color:#ccc;margin:0 8px;">·</span>
                <span style="color:#444;font-weight:600;">SL</span>
                {%- if row.sheet_sl_1f is not none %} 1F {{ "%.2f"|format(row.sheet_sl_1f) }}{% endif -%}
                {%- if row.sheet_sl_go is not none %} <span style="color:#999;">·</span> SL GO {{ "%.2f"|format(row.sheet_sl_go) }}{% endif -%}
              {%- endif %}
            </div>
          </td>
        </tr>
        {%- endif %}
        {#- ─ row 4: commercial line ─ -#}
        <tr>
          <td colspan="{{ ncols }}" style="padding:6px 16px 14px;">
            <div style="font-size:12px;color:#666;">
              <span style="color:#888;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;">Lot {{ row.lot }} &middot; {{ short_sale }}</span>
              {%- if price or buyer or vendor %} <span style="color:#bbb;margin:0 6px;">|</span> {% endif -%}
              {%- if price %}<span style="color:#1a1a1a;font-weight:600;">{{ price }}</span>{% endif -%}
              {%- if price and (buyer or vendor) %} &middot; {% endif -%}
              {%- if buyer %}{{ buyer }}{% endif -%}
              {%- if buyer and vendor %} &middot; {% endif -%}
              {%- if vendor %}<span style="color:#888;">{{ vendor }}</span>{% endif -%}
            </div>
          </td>
        </tr>
      </table>
    {%- endmacro -%}

    {#- ───────── Sections ───────── -#}

    {% if mode in ("evening", "weekly") %}
      {% if ran_today %}
      <h2 style="font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#666;margin:24px 0 10px;">
        {% if mode == "weekly" %}Ran this week{% else %}Ran today{% endif %} &middot; {{ ran_today|length }}
      </h2>
      {% for row in ran_today %}{{ horse_card(row, ran=true, show_date=(mode == "weekly")) }}{% endfor %}
      {% else %}
      <div style="background:#fff;border:1px solid #e3e3de;border-radius:8px;padding:20px;">
        <p style="margin:0;color:#444;font-size:15px;font-weight:600;">{% if mode == "weekly" %}No Runners This Week{% else %}No Results Today{% endif %}</p>
      </div>
      {% endif %}

      {% if mode == "weekly" %}
      <p style="margin:14px 0 0;color:#666;font-size:12px;">
        Full season racing-results workbook attached (per-lot First Time Out / Peak RPR + Breeze Rating bands).
      </p>
      {% endif %}

      {% if season_summary %}
      <h2 style="font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#666;margin:32px 0 10px;">
        Season to date &middot; {{ run_date.year }} &middot; {{ season_summary.total_runs }} run{{ '' if season_summary.total_runs == 1 else 's' }}
      </h2>

      {% if season_summary.by_breeze_band %}
      <table cellpadding="0" cellspacing="0" border="0" width="100%" style="background:#fff;border:1px solid #e3e3de;border-radius:8px;margin-bottom:12px;">
        <tr><td colspan="5" style="padding:10px 12px 4px;font-size:12px;font-weight:700;color:#1a1a1a;letter-spacing:0.04em;">Form by Breeze rating</td></tr>
        {{ stat_table_header() }}
        <tbody>
          {%- for r in season_summary.by_breeze_band %}
          {{ stat_row(r.label, r.n_runners, r.n_winners, r.strike_rate, r.avg_rpr, r.low_n) }}
          {%- endfor %}
        </tbody>
      </table>
      {% endif %}

      {% if season_summary.by_precocity_band %}
      <table cellpadding="0" cellspacing="0" border="0" width="100%" style="background:#fff;border:1px solid #e3e3de;border-radius:8px;margin-bottom:12px;">
        <tr><td colspan="5" style="padding:10px 12px 4px;font-size:12px;font-weight:700;color:#1a1a1a;letter-spacing:0.04em;">Form by Precocity rating</td></tr>
        {{ stat_table_header() }}
        <tbody>
          {%- for r in season_summary.by_precocity_band %}
          {{ stat_row(r.label, r.n_runners, r.n_winners, r.strike_rate, r.avg_rpr, r.low_n) }}
          {%- endfor %}
        </tbody>
      </table>
      {% endif %}

      {% if season_summary.by_sale %}
      <table cellpadding="0" cellspacing="0" border="0" width="100%" style="background:#fff;border:1px solid #e3e3de;border-radius:8px;margin-bottom:12px;">
        <tr><td colspan="5" style="padding:10px 12px 4px;font-size:12px;font-weight:700;color:#1a1a1a;letter-spacing:0.04em;">Form by Sale</td></tr>
        <thead>
          <tr>
            <th style="padding:6px 8px;text-align:left;font-size:10px;color:#888;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;">Sale</th>
            <th style="padding:6px 8px;text-align:right;font-size:10px;color:#888;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;">Runners</th>
            <th style="padding:6px 8px;text-align:right;font-size:10px;color:#888;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;">Wins</th>
            <th style="padding:6px 8px;text-align:right;font-size:10px;color:#888;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;">SR</th>
            <th style="padding:6px 8px;text-align:right;font-size:10px;color:#888;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;">Avg RPR</th>
          </tr>
        </thead>
        <tbody>
          {%- for r in season_summary.by_sale %}
          {{ stat_row(r.sale_label, r.n_runners, r.n_winners, r.strike_rate, r.avg_rpr, r.low_n) }}
          {%- endfor %}
        </tbody>
      </table>
      {% endif %}

      {% if season_summary.top_breeze %}
      <h3 style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#666;margin:18px 0 8px;">
        Top 10 by Breeze rating
      </h3>
      {{ top_table(season_summary.top_breeze, "Breeze") }}
      {% endif %}

      {% if season_summary.top_precocity %}
      <h3 style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#666;margin:18px 0 8px;">
        Top 10 by Precocity rating
      </h3>
      {{ top_table(season_summary.top_precocity, "Precocity") }}
      {% endif %}

      <p style="font-size:11px;color:#999;font-style:italic;margin-top:4px;">
        Italic rows = small sample (n &lt; {{ season_summary.low_n_threshold }}).
      </p>
      {% endif %}
    {% else %}
      {% if entered %}
      <h2 style="font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#666;margin:24px 0 10px;">
        Entries &amp; declarations &middot; next {{ entries_window_days }} day{{ '' if entries_window_days == 1 else 's' }} &middot; {{ entered|length }}
      </h2>
      {% for row in entered %}{{ horse_card(row) }}{% endfor %}
      {% else %}
      <div style="background:#fff;border:1px solid #e3e3de;border-radius:8px;padding:20px;">
        <p style="margin:0;color:#444;">No breeze-up graduates entered in the next {{ entries_window_days }} day{{ '' if entries_window_days == 1 else 's' }}.</p>
      </div>
      {% endif %}
    {% endif %}

    {% if diagnostics and diagnostics.get("sheet_status") and total > 0 %}
    <p style="margin-top:18px;color:#999;font-size:11px;">
      Sheet enrichment: {{ diagnostics.sheet_status }}.
    </p>
    {% endif %}

    <p style="margin-top:24px;color:#aaa;font-size:11px;line-height:1.5;">
      Sourced from Racing Post bloodstock sale catalogues (entries flag, matched by horse_uid on results).
      Breeze, Precocity, OT and SL ratings joined from the gSheet on (year, sale, lot).
    </p>
  </div>
</body>
</html>
