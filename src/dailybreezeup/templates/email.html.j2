<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>{{ subject }}</title>
</head>
<body style="font-family:-apple-system,Segoe UI,Helvetica,Arial,sans-serif;color:#222;background:#f7f7f5;margin:0;padding:20px;">
  <div style="max-width:860px;margin:0 auto;background:#fff;border:1px solid #e3e3de;padding:24px;">
    <h1 style="margin:0 0 4px 0;font-size:20px;">Breeze-up graduates</h1>
    <p style="margin:0 0 24px 0;color:#666;font-size:13px;">
      {{ run_date.strftime("%A %d %B %Y") }} &middot; {{ total }} horse{{ '' if total == 1 else 's' }}
    </p>

    {% macro horse_cell(row) -%}
      <strong>{{ row.horse_name or ('Lot ' ~ row.lot ~ ' (unnamed)') }}</strong>
      <div style="color:#555;font-size:11px;margin-top:2px;">
        {% if row.sire %}{{ row.sire }}{% endif %}{% if row.dam %} &times; {{ row.dam }}{% endif %}{% if row.damsire %} ({{ row.damsire }}){% endif %}
      </div>
    {%- endmacro %}

    {% macro sale_cell(row) -%}
      {{ row.sale_name }}
      <div style="color:#555;font-size:11px;margin-top:2px;">
        Lot {{ row.lot }}{% if row.price %} &middot; {{ row.price }}{% endif %}{% if row.buyer %} &middot; {{ row.buyer }}{% endif %}
      </div>
    {%- endmacro %}

    {% if ran_today %}
    <h2 style="font-size:16px;border-bottom:1px solid #e3e3de;padding-bottom:6px;">Ran today ({{ ran_today|length }})</h2>
    <table width="100%" cellspacing="0" cellpadding="8" style="border-collapse:collapse;font-size:13px;margin-bottom:24px;">
      <thead>
        <tr style="background:#faf7f0;">
          <th align="left">Horse</th>
          <th align="left">Sale</th>
          <th align="left">Race</th>
          <th align="left">Finish</th>
          <th align="left">SP</th>
        </tr>
      </thead>
      <tbody>
      {% for row in ran_today %}
        <tr style="border-top:1px solid #eee;vertical-align:top;">
          <td>{{ horse_cell(row) }}</td>
          <td>{{ sale_cell(row) }}</td>
          <td>
            <a href="{{ row.race_url }}" style="color:#1a5fb4;text-decoration:none;">
              {% if row.off_time %}{{ row.off_time.strftime("%H:%M") }} {% endif %}{{ row.course }}
            </a>
            <div style="color:#555;font-size:11px;">{{ row.race_name }}</div>
          </td>
          <td><strong>{{ row.finishing_position or '-' }}</strong></td>
          <td>{{ row.sp or '-' }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    {% endif %}

    {% if entered %}
    <h2 style="font-size:16px;border-bottom:1px solid #e3e3de;padding-bottom:6px;">Entered in the next {{ entries_window_days }} day{{ '' if entries_window_days == 1 else 's' }} ({{ entered|length }})</h2>
    <table width="100%" cellspacing="0" cellpadding="8" style="border-collapse:collapse;font-size:13px;margin-bottom:24px;">
      <thead>
        <tr style="background:#faf7f0;">
          <th align="left">Horse</th>
          <th align="left">Sale</th>
          <th align="left">When</th>
          <th align="left">Course</th>
        </tr>
      </thead>
      <tbody>
      {% for row in entered %}
        <tr style="border-top:1px solid #eee;vertical-align:top;">
          <td>{{ horse_cell(row) }}</td>
          <td>{{ sale_cell(row) }}</td>
          <td>{{ row.race_date.strftime("%a %d %b") }}</td>
          <td>
            <a href="{{ row.race_url }}" style="color:#1a5fb4;text-decoration:none;">{{ row.course }}</a>
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    {% endif %}

    {% if total == 0 %}
    <p style="color:#666;">No breeze-up graduates ran today and none are entered in the next {{ entries_window_days }} day{{ '' if entries_window_days == 1 else 's' }}.</p>
    {% endif %}

    <p style="margin-top:32px;color:#999;font-size:11px;">
      Sent by dailybreezeup. Sourced from Racing Post bloodstock sale catalogues (entries flag, matched by horse_uid on results).
    </p>
  </div>
</body>
</html>
