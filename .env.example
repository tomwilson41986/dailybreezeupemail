# Gmail SMTP — requires 2FA on the Google account, then generate a 16-char
# app password at https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional SMTP overrides (defaults are Gmail)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# EMAIL_FROM is optional; defaults to GMAIL_USER.
# Gmail will rewrite the From header to GMAIL_USER unless EMAIL_FROM is a
# configured alias for that Gmail account.
EMAIL_FROM=
EMAIL_TO=you@example.com

# Optional knobs
NOTIFY_ON_EMPTY=false
# Forward window (in days, inclusive) for the racecards scrape that powers the
# "Entered" section. Default 3. This is the expensive path (one racecard walk
# per day) and declarations only publish ~48h out, so a tight window is fine.
ENTRIES_WINDOW_DAYS=3
# Forward window (in days, inclusive) for the catalogue entry_details fallback.
# The catalogue is fetched for free and knows about entries days before they
# hit the racecards (UK flat entries close at the 5-6 day stage), so it gets a
# wider horizon — otherwise a grad whose only engagement is 4+ days out is
# dropped from every morning email until the race falls inside the racecard
# window. Default 7: covers the entry-closing stage without surfacing the
# months-out long-range entries the catalogue also carries. Set huge (e.g.
# 9999) to surface every future entry flagged in the catalogue.
CATALOGUE_ENTRIES_WINDOW_DAYS=7
DB_PATH=data/breezeup.sqlite

# Google Sheet (CSV export URL) used to enrich entries with the master cohort.
# Rows are joined on (Year, Sale, Lot) to surface Breeze Rating, Precocity
# Rating, OT Rank, etc. in the email. The default points at the working sheet;
# override here if you maintain your own copy.
SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/12neJo7BsCsHg20m-es5ERkLJCevUzXyMDnvV9-ygrMk/export?format=csv

# ---------------------------------------------------------------------------
# Daily Sales Catalogues digest (salescatalogues-daily)
# ---------------------------------------------------------------------------
# Additional recipients for the catalogues digest, on top of the hardcoded
# always-recipients in salescatalogues/config.py (_ALWAYS_RECIPIENTS). Falls
# back to EMAIL_TO when blank. Comma / semicolon / newline separated.
CATALOGUES_EMAIL_TO=
# Days before a sale's first day that it counts as "Active" (brief: 2).
ACTIVE_LEAD_DAYS=2
# Only list sales starting within this many days ahead.
HORIZON_DAYS=30
# The catalogues job keeps its own SQLite ledger (data/salescatalogues.sqlite,
# separate from the breeze-up DB) to drive the "New" flag across runs.
