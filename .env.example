# Gmail SMTP — requires 2FA on the Google account, then generate a 16-char
# app password at https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional SMTP overrides (defaults are Gmail)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# EMAIL_FROM is optional; defaults to GMAIL_USER.
# Gmail will rewrite the From header to GMAIL_USER unless EMAIL_FROM is a
# configured alias for that Gmail account.
EMAIL_FROM=
EMAIL_TO=you@example.com

# Optional knobs
NOTIFY_ON_EMPTY=false
# Forward window (in days, inclusive) for the "Entered" section.
# Default 3. Set huge (e.g. 9999) to surface every future entry currently
# flagged in the RP catalogue, regardless of how far out the race is.
ENTRIES_WINDOW_DAYS=3
DB_PATH=data/breezeup.sqlite

# Google Sheet (CSV export URL) used to enrich entries with the master cohort.
# Rows are joined on (Year, Sale, Lot) to surface Breeze Rating, Precocity
# Rating, OT Rank, etc. in the email. The default points at the working sheet;
# override here if you maintain your own copy.
SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/12neJo7BsCsHg20m-es5ERkLJCevUzXyMDnvV9-ygrMk/export?format=csv
